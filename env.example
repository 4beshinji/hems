# ============================================================
# HEMS (Home Environment Management System) Configuration
# ============================================================
# Quick start (generates .env with random secrets if missing):
#   make quickstart
#
# Manual setup:
#   cp env.example .env
#   python infra/scripts/init_env.py
#   cd infra && docker compose up -d --build

# === System ===
LOG_LEVEL=INFO
TZ=Asia/Tokyo
# DATA_DIR=/app/data                      # base directory for app-generated data (logs, cache, etc.)
# CONFIG_DIR=/app/config                  # character/config root (default: /config in Docker, ./config in local dev)

# === Host Port Mapping ===
# Defaults are offset from SOMS (80/1883/8000-8002) to allow coexistence.
# Override any port to resolve conflicts or match your setup.
# HEMS_PORT_FRONTEND=8080
# HEMS_PORT_BACKEND=8010
# HEMS_PORT_MOCK_LLM=8011
# HEMS_PORT_VOICE=8012
# HEMS_PORT_MQTT=1893
# HEMS_PORT_VOICEVOX=50031
# HEMS_PORT_OLLAMA=11444
# HEMS_PORT_POSTGRES=5442

# === Internal Service Auth ===
# Shared secret for brain/backend → voice-service/stt inter-service calls.
# If empty: auth check is skipped (dev mode). Set a strong random string for production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# HEMS_INTERNAL_TOKEN=
# Internal brain APIs (aiohttp server)
# BRAIN_CHAT_URL=http://brain:8080/chat
# BRAIN_CHAT_PORT=8080

# === MQTT Broker ===
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# MQTT_BIND_ADDR=127.0.0.1  # Restrict MQTT listener (default: 127.0.0.1)
# Shared password for all internal MQTT clients. Change before first deployment.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MQTT_PASS=CHANGE_ME_BEFORE_USE
# MQTT_USER=hems  # Username for internal MQTT clients (default: hems)

# === LLM Configuration ===
# Provider: openai | anthropic | ollama
LLM_PROVIDER=ollama
# API URL options:
#   http://ollama:11434/v1               (Docker Ollama — default, requires --profile ollama)
#   http://host.docker.internal:11434/v1 (Host Ollama — if Ollama runs on host)
#   http://mock-llm:8000/v1              (Development mock)
#   https://api.openai.com/v1            (OpenAI Cloud)
LLM_API_URL=http://ollama:11434/v1
LLM_MODEL=gemma4:e4b-it-q8_0
# LLM_NUM_CTX=16384  # Baked into Modelfile (Ollama ignores options via /v1 API)
# Heavy task model (boot_load: pre-dawn briefing generation)
BOOT_LOAD_API_URL=http://ollama:11434/v1
BOOT_LOAD_MODEL=gemma4:26b-a4b-it-q4_K_M
BOOT_LOAD_PROVIDER=ollama
BOOT_LOAD_MAX_TOKENS=1600
BOOT_LOAD_WINDOW_SEC=3600
# Quantization by VRAM: Q3_K_M(~14GB) Q4_K_M(~17GB) Q5_K_M(~20GB) Q6_K(~22GB) Q8_0(~29GB)
# NOTE: Ollama's usable VRAM ≈ total − ~2GiB. A 16GB card exposes only ~14GiB,
# so a model must be ≲13GB to fully GPU-offload — measured: qwen3.5:9b-q8_0
# (12GB) loads 100% GPU; a 27B (~15GB) fails to load. Pick a quant accordingly.
# VRAM auto-select: python infra/scripts/gpu_setup.py --auto-select
# Alternatives: qwen3.5:9b-q8_0 (largest recent dense that fully fits 16GB),
#               qwen3:30b-a3b-instruct-2507-q4_K_M (MoE)
# Cloud alternatives (set LLM_PROVIDER accordingly):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# === Sunrise Alarm (gradual wake-up light) ===
# SUNRISE_ALARM_DEVICE=zigbee.0x781c9dfffee1557e  # Zigbee device_id for bedside light
# SUNRISE_ALARM_START_SEC=7200   # Start ramp 2h before predicted wake (default: 7200)
# SUNRISE_ALARM_END_SEC=1800     # Reach max 30min before predicted wake (default: 1800)
# SUNRISE_ALARM_MIN_BRIGHTNESS=1    # (default: 1)
# SUNRISE_ALARM_MAX_BRIGHTNESS=254  # (default: 254)
# SUNRISE_ALARM_STEP_SEC=30         # Brightness step interval (default: 30)

# === TTS (Text-to-Speech) ===
# Provider: espeak | voicevox | voisona | edge-tts | aivoice
TTS_PROVIDER=voicevox
# Fallback provider (used when primary fails)
TTS_FALLBACK=espeak
# VOICEVOX_URL=http://voicevox:50021
# VOISONA_URL=http://192.168.1.x:32766
# VOISONA_USERNAME=your-voisona-email
# VOISONA_PASSWORD=your-voisona-password
# VOISONA_VOICE_NAME=nurse-robot-type-t_ja_JP
# VOISONA_LANGUAGE=ja_JP
# AIVOICE_URL=http://host.docker.internal:8080  # AI Voice server (SSML variant)

# === Security ===
# Shared key for the dashboard API (backend dashboard routers, auth.verify_api_key).
# LAN-trusted by default: when unset the dashboard API is open (zero-config).
# When set, all dashboard routers require `Authorization: Bearer <key>`. Both
# clients are wired to send it automatically: the brain (dashboard_client + every
# brain→backend caller, via backend_auth_headers) and the frontend (nginx injects
# it into the /api/ proxy). Distinct from HEMS_INTERNAL_TOKEN above, which gates
# voice-service / stt — the two secrets are independent and may differ.
# For external exposure, also protect via nginx Basic auth or a reverse proxy.
# BACKEND_API_KEY=
# Backend API & dashboard URLs (internal routing)
# BACKEND_URL=http://backend:8000
# DASHBOARD_API_URL=http://backend:8000
# VOICE_SERVICE_URL=http://voice-service:8000  # Used by chat / mobile TTS proxy

# === Chat Rate Limiting ===
# Token bucket rate limit for POST /chat/ endpoint (prevents DoS).
# CHAT_RATE_LIMIT_CAPACITY=10     # Max tokens in bucket (default: 10)
# CHAT_RATE_LIMIT_REFILL=0.5      # Tokens per second (default: 0.5)
# Set CHAT_RATE_LIMIT_CAPACITY=0 to disable rate limiting.

# Frontend/browser allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# === Frontend dev env vars (Vite) ===
# VITE_BACKEND_URL: backend base URL used both by vite.config.ts (dev proxy target)
# and at runtime in the browser when bypassing the nginx /api/ proxy.
# In production leave unset — nginx rewrites /api/ → backend automatically.
# In dev (pnpm dev), set to point at the running backend, e.g.:
# VITE_BACKEND_URL=http://localhost:8010

# === Mobile Companion App ===
# Per-device keys / HMAC secrets are generated at /mobile/register time.
# Override lengths only if you have strong reason to.
# MOBILE_DEVICE_KEY_BYTES=32       # hex-encoded random, resulting key = 2 × bytes chars
# MOBILE_HMAC_SECRET_BYTES=32
# Phone-visible URL returned in the registration QR payload. Required when
# the phone connects through a reverse proxy / Tailscale hostname that differs
# from the internal docker name. Leave empty when the QR carrier passes it explicitly.
# BACKEND_PUBLIC_URL=https://hems.tailnet.example/api
# Character version label surfaced in the registration QR and voice-capsule manifest;
# used by the phone to invalidate cached audio when the persona changes.
# CHARACTER_VERSION=default@v1

# === Database ===
# Default: PostgreSQL (core service since W4.5').
# On first setup, run `make quickstart` (or `python infra/scripts/init_env.py`)
# to auto-generate a secure POSTGRES_PASSWORD; the placeholder below is only
# a fallback and will be replaced.
DATABASE_URL=postgresql+asyncpg://hems:${POSTGRES_PASSWORD}@postgres:5432/hems
POSTGRES_USER=hems
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
# SQLite-only mode (development / lightweight option):
#   DATABASE_URL=sqlite+aiosqlite:///./data/hems.db
# Use `make quickstart-sqlite` to start the stack without PostgreSQL.

# === AI Character ===
# Built-in templates: default | ena | tsundere | gentle-senpai | butler
CHARACTER=default
# Custom character file (overrides CHARACTER):
# CHARACTER_FILE=./config/character.yaml

# === GPU Configuration ===
# Auto-detected by: python infra/scripts/gpu_setup.py
# GPU type: amd | nvidia | none
GPU_TYPE=amd
# AMD GPU GFX version override (e.g., 10.3.0 for RDNA 2, 11.0.0 for RDNA 3).
# Only applies when GPU_TYPE=amd. Required for Ollama stability on some AMD cards.
# See: https://github.com/ollama/ollama/blob/main/docs/troubleshooting.md#amd-radeon
HSA_OVERRIDE_GFX_VERSION=10.3.0
GPU_HIGH_LOAD_THRESHOLD=80
# GPU_NAME=
# GPU_VRAM_MB=

# === Environment Thresholds ===
# Override default thresholds for alerts and rules.
# Single source of truth: rules/config.py (RuleThresholds).
# HEMS_THRESHOLD_CO2_HIGH=1000
# HEMS_THRESHOLD_CO2_CRITICAL=1500
# HEMS_THRESHOLD_TEMP_HIGH=28
# HEMS_THRESHOLD_TEMP_LOW=16
# HEMS_THRESHOLD_HUMIDITY_HIGH=70
# HEMS_THRESHOLD_HUMIDITY_LOW=30
# HEMS_THRESHOLD_SEDENTARY_MINUTES=60
# HEMS_THRESHOLD_PC_CPU_HIGH=90
# HEMS_THRESHOLD_PC_MEMORY_HIGH=90
# HEMS_THRESHOLD_PC_GPU_TEMP_HIGH=85
# HEMS_THRESHOLD_PC_DISK_HIGH=90
# HEMS_THRESHOLD_SCREEN_TIME_MINUTES=120
# HEMS_THRESHOLD_POWER_IDLE_WATTS=5
# PM2.5 high threshold (canonical; shared by world-model estimate + native sensor rule)
# HEMS_THRESHOLD_PM25_HIGH=35
# deprecated, use HEMS_THRESHOLD_PM25_HIGH
# HEMS_THRESHOLD_PM25_NATIVE=35

# Freshness / degraded-operation time windows (seconds, not alert thresholds)
# HEMS_ENV_STALE_SEC=300
# HEMS_ZONE_BLIND_SEC=300

# Fatigue scoring weights (components of fatigue_score calculation)
# FATIGUE_HR_WEIGHT=0.3
# FATIGUE_HRV_WEIGHT=0.2
# FATIGUE_SLEEP_WEIGHT=0.3
# FATIGUE_STRESS_WEIGHT=0.2

# Brain cognitive cycle timing
# HEMS_NORMAL_HEARTBEAT_INTERVAL=30      # main ReAct cycle interval (seconds)
# HEMS_NORMAL_CYCLE_INTERVAL=30
# Low-power mode thresholds & timing (GPU high load / low battery)
# HEMS_LOW_POWER_SLEEP_INTERVAL=120      # cycle interval when sleeping
# HEMS_LOW_POWER_SLEEP_MIN_INTERVAL=90
# HEMS_LOW_POWER_AWAY_INTERVAL=120       # cycle interval when away
# HEMS_LOW_POWER_AWAY_MIN_INTERVAL=60
# HEMS_LOW_POWER_LLM_COOLDOWN=600        # suppress LLM calls after high-load event (seconds)
# HEMS_LOW_POWER_AWAY_CONFIRM=600        # time to confirm away status before entering low-power

# Manual override duration
# HEMS_MANUAL_OVERRIDE_DURATION=3600     # duration of manual device control overrides (seconds)

# Reminders
# REMINDER_INTERVAL_MINUTES=60
# REMINDER_COOLDOWN_MINUTES=30
# REMINDER_CHECK_INTERVAL_SECONDS=300

# External URLs (for sharing / integrations)
# HEMS_EXTERNAL_URL=https://hems.example.com

# Critical thresholds (low-power / safety mode)
# HEMS_THRESHOLD_TEMP_CRITICAL_HIGH=40.0
# HEMS_THRESHOLD_TEMP_CRITICAL_LOW=5.0
# HEMS_THRESHOLD_SPO2_CRITICAL_LOW=88
# HEMS_THRESHOLD_HR_CRITICAL_SLEEP=150

# Heavy process thresholds (PC)
# HEMS_PROC_CPU_HIGH=90
# HEMS_PROC_CPU_SUSTAIN_S=300
# HEMS_PROC_MEM_HIGH_GB=4.0
# HEMS_PROC_COOLDOWN_S=1800
# HEMS_PROC_HEAVY_EXCLUDE=

# Device health thresholds
# HEMS_DEVICE_BATTERY_LOW=10
# HEMS_DEVICE_LQI_LOW=50
# HEMS_DEVICE_STALE_HOURS=24

# Sensor utilization thresholds
# HEMS_THRESHOLD_SOIL_LOW=25
# HEMS_ENABLE_AUTO_WATER=false
# HEMS_AUTO_WATER_DURATION_S=45      # clamped to max 45
# HEMS_THRESHOLD_VOC_HIGH=500
# HEMS_VOC_SUSTAIN_SECONDS=120
# HEMS_VOC_COOLDOWN_SECONDS=1800
# HEMS_THRESHOLD_PRESSURE_LOW=1000
# HEMS_PRESSURE_LOW_SUSTAIN_S=10800
# HEMS_THRESHOLD_LIGHT_LOW=20
# HEMS_LIGHT_LOW_SUSTAIN_S=600
# HEMS_THRESHOLD_LIGHT_HIGH=50000
# HEMS_LIGHT_HIGH_SUSTAIN_S=600

# Lighting automation
# HEMS_ABSENCE_LIGHTING_ENABLED=true
# HEMS_ABSENCE_LIGHTING_INTERVAL=1800
# HEMS_ABSENCE_LIGHTING_HOURS_START=17
# HEMS_ABSENCE_LIGHTING_HOURS_END=23
# HEMS_CIRCADIAN_ENABLED=true
# HEMS_CIRCADIAN_INTERVAL=1800

# === OpenClaw Integration (PC metrics + service monitor) ===
# Enable with: docker compose --profile openclaw up
# Built from the legacy localcraw bridge until the OpenClaw package is split out.
# OPENCLAW_METRICS_INTERVAL=10
# OPENCLAW_PROCESS_INTERVAL=30
# HEMS_PORT_OPENCLAW_BRIDGE=8013
# OPENCLAW_BRIDGE_URL=http://openclaw-bridge:8000
# LOCALCRAW_BRIDGE_URL=http://localcraw-bridge:8000  # legacy alias

# === Service Monitor (OpenClaw bridge) ===
# Gmail (IMAP — requires App Password)
# HEMS_GMAIL_ENABLED=true
# HEMS_GMAIL_EMAIL=user@gmail.com
# HEMS_GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# HEMS_GMAIL_INTERVAL=300
# GitHub (REST API — requires Personal Access Token)
# HEMS_GITHUB_ENABLED=true
# HEMS_GITHUB_TOKEN=ghp_xxxx
# HEMS_GITHUB_INTERVAL=300
# Browser-based checkers (JSON array — Playwright/Chromium内蔵、Gateway不要)
# HEMS_BROWSER_CHECKERS=[]
# VIP filtering (B-2): comma-separated tokens that elevate service edge events
# to severity=2 (immediate speak). Brain matches against event summary/details.
# HEMS_GMAIL_VIP_SENDERS=boss@example.com,family@example.com
# HEMS_GITHUB_VIP_REPOS=org/critical-repo,team/release-train

# === Obsidian Integration (Knowledge store) ===
# Enable with: docker compose --profile obsidian up
# OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
# OBSIDIAN_BRIDGE_URL=http://obsidian-bridge:8000
# OBSIDIAN_WATCHER_DEBOUNCE=2.0
# OBSIDIAN_MAX_SEARCH_RESULTS=10  # Max local vault search results (default: 10)
# HEMS_PORT_OBSIDIAN_BRIDGE=8014

# === Persona Rewriter ===
# Rewrite rule-engine speak messages in character voice (adds ~1-3s latency)
# Disable if using local LLM (Ollama) with GPU under high load
# PERSONA_REWRITE_ENABLED=true
# PERSONA_REWRITE_CACHE_TTL=3600

# === Ambient Speaker ===
# Periodic natural one-line speech based on sensor data
# AMBIENT_SPEAK_ENABLED=true        # (default: true)
# AMBIENT_SPEAK_INTERVAL=300        # seconds between ambient utterances (default: 300)

# === Wake / Schedule Fallback ===
# FALLBACK_WAKE_TIME=07:00          # assumed wake time when no biometric/schedule signal (default: 07:00)

# === GAS Integration (Google Apps Script) ===
# Enable with: docker compose --profile gas up
# Deploy Code.gs as Web App (see scripts/gas-bridge/README.md)
# GAS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
# GAS_API_KEY=your-api-key-here
# GAS_BRIDGE_URL=http://gas-bridge:8000
# HEMS_PORT_GAS_BRIDGE=8015
# Polling intervals (seconds)
# HEMS_GAS_CALENDAR_INTERVAL=120
# HEMS_GAS_TASKS_INTERVAL=300
# HEMS_GAS_GMAIL_INTERVAL=300
# HEMS_GAS_SHEETS_INTERVAL=600
# HEMS_GAS_DRIVE_INTERVAL=600
# Sheets to monitor (name:spreadsheet_id:sheet_name:range)
# HEMS_GAS_SHEETS=budget:1xABC:Sheet1:A1:D20

# === Home Assistant Integration (Smart home) ===
# Enable with: docker compose --profile ha up
# Requires Home Assistant running (locally or via Docker)
# HA_URL=http://host.docker.internal:8123
# HA_TOKEN=your-long-lived-access-token
# HA_BRIDGE_URL=http://ha-bridge:8000
# HEMS_PORT_HA_BRIDGE=8016
# HEMS_HA_POLL_INTERVAL=30
# Entity mapping (JSON: {"light.bedroom": {"zone": "bedroom", "domain": "light"}})
# HEMS_HA_ENTITY_MAP={}
# HA config path for containerized HA
# HEMS_HA_CONFIG_PATH=./ha-config
# Matter server data path (--profile ha)
# HEMS_MATTER_DATA_PATH=./matter-data

# === Biometric Integration (Smartband) ===
# Enable with: docker compose --profile biometric up
# BIOMETRIC_BRIDGE_URL=http://biometric-bridge:8000
# HEMS_PORT_BIOMETRIC_BRIDGE=8017
# BIOMETRIC_PROVIDER=gadgetbridge
# REQUIRED when biometric profile is used:
# BIOMETRIC_WEBHOOK_SECRET=hems_dev_biometric_secret
# BIOMETRIC_DB_PATH=/data/send_queue.db  # bridge delivery DB: legacy MQTT queue + canonical inbox/outbox; not history SoT
# Webhook replay protection (W1.3). Set to true once companion apps send X-Timestamp + X-Nonce.
# false (default): legacy requests without timestamp/nonce are accepted with a WARNING.
# true:            requests missing X-Timestamp or X-Nonce are rejected with 401.
# Applies to both biometric-bridge and the backend mobile state-webhook.
# WEBHOOK_REPLAY_STRICT=false

# --- Path 1: Health Connect Companion App (primary) ---
# Install the HEMS Health app on Android (apps/healthconnect-companion/)
# Configure bridge URL and webhook secret in the app settings.
# The app reads Health Connect data (written by Mi Fitness) every 15min.

# --- Path 2: Huami Cloud API (fallback/supplementary) ---
# Obtain token: pip install huami-token && huami-token --method xiaomi
# HUAMI_ENABLED=true
# HUAMI_AUTH_TOKEN=your_huami_app_token
# HUAMI_USER_ID=your_huami_user_id
# HUAMI_SERVER_REGION=us          # us | cn | eu | sg | ru
# HUAMI_POLL_INTERVAL=900         # 15 minutes

# --- Path 3: Zepp (Amazfit Cloud) ---
# ZEPP_ENABLED=false
# ZEPP_EMAIL=your_zepp_email
# ZEPP_PASSWORD=your_zepp_password
# ZEPP_POLL_INTERVAL=900          # 15 minutes

# --- Deduplication ---
# Window (seconds) to suppress duplicate data from dual-path overlap
# BIOMETRIC_DEDUP_WINDOW=300      # 5 minutes

# Biometric thresholds
# HEMS_THRESHOLD_HR_HIGH=120
# HEMS_THRESHOLD_HR_LOW=45
# HEMS_THRESHOLD_SPO2_LOW=92
# HEMS_THRESHOLD_STRESS_HIGH=80
# HEMS_THRESHOLD_HRV_LOW=20
# HEMS_THRESHOLD_BODY_TEMP_HIGH=37.5
# HEMS_THRESHOLD_RESPIRATORY_RATE_HIGH=25
# HEMS_BIOMETRIC_STALE_MINUTES=30

# === SwitchBot Integration (Direct API v1.1) ===
# Enable with: docker compose --profile switchbot up
# Requires SwitchBot Cloud API token + secret (SwitchBot app → Profile → Preferences)
# SWITCHBOT_TOKEN=your-switchbot-token
# SWITCHBOT_SECRET=your-switchbot-secret
# SWITCHBOT_BRIDGE_URL=http://switchbot-bridge:8000
# HEMS_PORT_SWITCHBOT_BRIDGE=8019
# SWITCHBOT_POLL_INTERVAL=30
# Device-to-zone mapping (JSON: {"DEVICE_ID": {"zone": "living_room", "name": "メインライト"}})
# SWITCHBOT_DEVICE_MAP={}
# Webhook URL (optional — SwitchBot pushes state changes to this URL)
# SWITCHBOT_WEBHOOK_URL=https://your-domain.com/api/webhook

# === Perception (Camera-based detection) ===
# Enable with: docker compose --profile perception up
# YOLOv11s-pose: person detection + skeleton (auto-downloads model on first run)
# PERCEPTION_BRIDGE_URL=http://perception:8000
# HEMS_PORT_PERCEPTION=8018
# Camera config (JSON array): type=mcp|stream, url required for stream
# HEMS_PERCEPTION_CAMERAS=[{"device_id":"cam01","zone":"living_room","type":"mcp"}]
# HEMS_PERCEPTION_MODEL=yolo11s.pt
# HEMS_PERCEPTION_POSE_MODEL=yolo11s-pose.pt
# HEMS_PERCEPTION_CONFIDENCE=0.5
# HEMS_PERCEPTION_INTERVAL=5

# === Zigbee2MQTT (Direct Zigbee control) ===
# Enable with: docker compose --profile zigbee up
# Requires Zigbee USB coordinator stick
# Fixed device name: sudo cp infra/udev/99-zigbee.rules /etc/udev/rules.d/
HEMS_Z2M_USB_DEVICE=/dev/ttyUSB0
# HEMS_PORT_Z2M_UI=8090

# === External Integrations (Phase 2: data-bridge — PLACEHOLDER, NOT WIRED) ===
# data-bridge は未稼働の placeholder (services/data-bridge/README.md 参照)。
# Google Calendar → gas-bridge で代替済 (--profile gas)
# Mi Band / Amazfit / Strava / Fitbit / Garmin → biometric-bridge で代替済 (--profile biometric, Health Connect 経由)
# 下記の env はすべて将来の data-bridge 実装再開時の予約 — 現在は読み込まれない。
# GOOGLE_CALENDAR_CREDENTIALS=./config/google_credentials.json
# STRAVA_CLIENT_ID=...
# STRAVA_CLIENT_SECRET=...
# FITBIT_CLIENT_ID=...
# FITBIT_CLIENT_SECRET=...
# GARMIN_USERNAME=...
# GARMIN_PASSWORD=...
# INTERVALS_ICU_API_KEY=...
# INTERVALS_ICU_ATHLETE_ID=i12345
# MIBAND_MODE=none

# === Tapo Integration (P110/P115 — direct LAN, no HA required) ===
# Enable with: docker compose --profile tapo up
# TAPO_USERNAME=
# TAPO_PASSWORD=
# TAPO_DEVICES={"plug_desklight":"192.168.1.42"}
# TAPO_ZONES={"plug_desklight":"bedroom"}
# TAPO_NAMES={"plug_desklight":"寝室デスクライト"}
# TAPO_POLL_INTERVAL=30   # seconds between power-metering polls (default: 30)
# TAPO_BRIDGE_URL=http://tapo-bridge:8000
# HEMS_PORT_TAPO_BRIDGE=8020

# === News (news-bridge — RSS + Ollama summarizer) ===
# Enable with: docker compose --profile news --profile ollama up
# NEWS_BRIDGE_URL=http://news-bridge:8000
# HEMS_PORT_NEWS_BRIDGE=8021
# NEWS_SOURCES=nhk_main,nhk_international,bbc_world,guardian_world
# NEWS_DAILY_HOUR=7
# NEWS_DAILY_MINUTE=30
# NEWS_POLL_INTERVAL=300
# NEWS_URGENCY_THRESHOLD=0.8
# NEWS_REFRESH_STALE_HOURS=2  # News briefing cache freshness threshold (default: 2)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3.5
# OLLAMA_SUMMARY_MODEL=

# === Knowledge (knowledge-bridge — multi-format document search) ===
# Enable with: docker compose --profile knowledge up
# KNOWLEDGE_BRIDGE_URL=http://knowledge-bridge:8000
# HEMS_PORT_KNOWLEDGE_BRIDGE=8022
# KNOWLEDGE_SOURCES=[{"name":"pws","path":"/sources/pws","extensions":[".md",".py",".pdf"]}]
# KNOWLEDGE_SOURCE_PWS=/sources/pws             # deprecated alias; use KNOWLEDGE_SOURCES instead
# KNOWLEDGE_MAX_SEARCH_RESULTS=20
# KNOWLEDGE_WATCHER_DEBOUNCE=3.0
# Vector search (optional, requires --profile ollama)
# EMBEDDING_URL=http://ollama:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_CACHE_DIR=/app/data/embeddings
# EMBEDDING_BATCH_SIZE=32
# RRF_K=60

# === STT (Speech-to-Text) ===
# Enable with: docker compose --profile stt up
# STT_PROVIDER=whisper                    # whisper | sherpa-onnx | qwen3-asr
# STT_MODEL=large-v3-turbo
# STT_MODEL_DIR=                          # cache directory for downloaded models (default: ~/.cache/hems/stt)
# STT_LANGUAGE=ja
# STT_DEVICE=auto                         # auto | cpu | cuda | rocm
# STT_COMPUTE_TYPE=auto                   # auto | float16 | int8
# STT_BEAM_SIZE=5                         # beam search width (faster ↔ more accurate)
# STT_LLM_REWRITE=false                   # enable LLM query cleaning (requires Ollama)
# STT_LLM_MODEL=                          # model for LLM rewrite (e.g., qwen3.5:9b)
# STT_MAX_AUDIO_SECONDS=60
# HEMS_PORT_STT=8023

# === VLM (Perception heavy model — optional) ===
# Requires --profile ollama + --profile perception
# VLM_ENABLED=false
# VLM_LIGHT_MODEL=moondream
# VLM_HEAVY_MODEL=minicpm-v
# VLM_OLLAMA_URL=http://ollama:11434     # Ollama endpoint for VLM (if separate from main LLM)
# VLM_BASE_INTERVAL=300                  # base polling interval (seconds)
# VLM_MIN_INTERVAL=60                    # minimum interval (faster when high-motion)
# VLM_MAX_INTERVAL=900                   # maximum interval (slower during idle)
# VLM_BOOST_DURATION=180                 # boost to min_interval during activity (seconds)
# VLM_MAX_TOKENS=1024                    # max tokens in VLM response
# VLM_IMAGE_MAX_SIZE=768                 # resize long edge to this (bytes/dimension tradeoff)
# VLM_TIMEOUT=30                         # timeout for VLM inference (seconds)

# === Weather Bridge (always-on, JMA default — no API key required) ===
# WEATHER_PROVIDER=jma                    # jma | openweathermap
# JMA_AREA_CODE=130000                    # 東京都. See https://www.jma.go.jp/bosai/common/const/area.json
# JMA_DETAIL_CODE=130010                  # 東京地方
# OWM_API_KEY=                            # required only when WEATHER_PROVIDER=openweathermap
# OWM_LAT=35.6762
# OWM_LON=139.6503
# OWM_UNITS=metric
# OWM_LANG=ja
# HEMS_WEATHER_CURRENT_INTERVAL=600
# HEMS_WEATHER_FORECAST_INTERVAL=1800

# === Automation Engine (backend AutomationRule evaluation) ===
# AUTOMATION_ENGINE_ENABLED=true          # evaluate sensor_threshold/schedule/event/device_state rules (default: on)
# AUTOMATION_EVAL_INTERVAL=30             # rule evaluation interval (seconds)
# AUTOMATION_REFRESH_INTERVAL=300         # refresh rules from DB (seconds)
# AUTOMATION_LLM_REVIEW_TIMEOUT=30        # timeout for LLM-based rule review (seconds)

# === Adaptive Thresholds (Phase 2 — brain drift detection) ===
# Drift detector used by brain adaptive threshold manager.
# HEMS_DRIFT_DETECTOR=adwin               # adwin | pagehinkley
# HEMS_DRIFT_DELTA=0.002                  # detection sensitivity
# HEMS_DRIFT_MIN_SAMPLES=30               # minimum samples before drift decision

# === Event Automation (event→action mapping) ===
# Default when unset: [{"event":"wake_up","actions":["morning_greeting","news_briefing","weather_report"]}]
# EVENT_AUTOMATIONS='[{"event":"wake_up","actions":["morning_greeting","news_briefing","weather_report"]},{"event":"scheduled","time":"12:00","actions":["news_briefing"]}]'

# === Boot Load model swap window ===
# BOOT_LOAD_ENABLED=true                  # pre-wake heavy briefing pre-synth (default: on)
# BOOT_LOAD_CACHE_DIR=/app/data/boot_load_cache   # disk cache survives brain restarts (per-day file, GC'd next day)
# BOOT_LOAD_NEWS_STALE_HOURS=2            # news_briefing refreshes the daily summary if cache is older than this

# === Schedule Learning & Travel ===
# Schedule state persistence (learner caches wake/sleep times)
# SCHEDULE_STATE_PATH=/app/data/schedule_state.json
# Travel time baseline matrix (JSON object)
# TRAVEL_TIMES_JSON={"bedroom→kitchen":300,"bedroom→living_room":180}
# Default minimum travel time for missing routes (seconds)
# TRAVEL_DEFAULT_MIN=180

# === Wake-up detection ===
# Camera-based wake_up trigger time window (24h clock). Person detected
# inside this window fires the wake_up event. Outside the window, only
# biometric sleep-end or the schedule-learner fallback can fire wake_up.
# WAKE_DETECT_HOUR_START=5
# WAKE_DETECT_HOUR_END=11

# === NVIDIA GPU ===
# Requires nvidia-container-toolkit:
#   sudo apt-get install -y nvidia-container-toolkit
#   sudo nvidia-ctk runtime configure --runtime=docker
#   sudo systemctl restart docker

# === Docker Compose ===
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_PROFILES=zigbee,switchbot

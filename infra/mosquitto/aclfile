# HEMS Mosquitto ACL File
# Per-service topic permissions — principle of least privilege
#
# Format:
#   user <username>
#   topic [read|write|readwrite] <topic_pattern>
#
# Run infra/mosquitto/setup-users.sh to (re)generate the passwd file.

# --- Brain service ---
# W3.8c: sensor/camera/activity telemetry is on hems/sensors/#.  office/* is
# retained only for backend task_report publish (read-only for brain).
user hems-brain
topic read     office/+/task_report/#
topic readwrite hems/#
topic readwrite mcp/#
topic readwrite zigbee2mqtt/#

# --- Backend API service ---
# Reads sensor/event data, publishes task reports and lifecycle events,
# and publishes timeline snapshots.
# W3.8c: task_report still uses office/{zone}/task_report/{id} (backend → brain).
user hems-backend
topic read   hems/#
topic write  office/+/task_report/#
topic write  hems/task/#
topic write  hems/timeline/#
topic write  hems/shopping/#

# --- Voice service ---
# No MQTT pub/sub needed (REST only), but subscribe to voice commands if needed.
user hems-voice
topic read   hems/brain/#

# --- HA Bridge ---
# Publishes home device state to hems/home/#.
# No need to subscribe (brain subscribes).
user hems-ha-bridge
topic write  hems/home/#
topic read   hems/home/bridge/status

# --- Biometric Bridge ---
# Publishes biometric readings to hems/personal/biometrics/#.
user hems-biometric
topic write  hems/personal/biometrics/#

# --- GAS Bridge ---
# Publishes Google data to hems/gas/#.
user hems-gas
topic write  hems/gas/#

# --- Obsidian Bridge ---
# Publishes note changes to hems/personal/notes/#.
user hems-obsidian
topic write  hems/personal/notes/#

# --- OpenClaw Bridge ---
# Publishes PC metrics to hems/pc/# and service status to hems/services/#.
user hems-openclaw
topic write  hems/pc/#
topic write  hems/services/#

# Legacy localcraw username retained for old bridge deployments.
user hems-localcraw
topic write  hems/pc/#
topic write  hems/services/#

# --- SwitchBot Bridge ---
# Publishes device state to hems/home/# (same namespace as HA bridge)
# and bridge status to hems/switchbot/#.
user hems-switchbot
topic write  hems/home/#
topic write  hems/switchbot/#

# --- Tapo Bridge ---
# Publishes state + power metering to hems/tapo/#.
user hems-tapo-bridge
topic write  hems/tapo/#

# --- Zigbee2MQTT daemon ---
# Publishes device state to zigbee2mqtt/# and listens for control commands
# on zigbee2mqtt/+/set (brain publishes these).
user hems-z2m
topic readwrite zigbee2mqtt/#

# --- Perception service ---
# Publishes camera/activity data to hems/sensors/{zone}/camera/# and
# hems/sensors/{zone}/activity/#.
# VLM results published to hems/perception/vlm/#.
user hems-perception
topic write  hems/sensors/+/camera/#
topic write  hems/sensors/+/activity/#
topic write  hems/perception/#
topic read   hems/perception/vlm/request

# --- News Bridge ---
# Publishes news summaries and alerts to hems/news/#.
user hems-news
topic write  hems/news/#

# --- IoT sensor devices (zone sensors, MCP agents) ---
# Sensors publish to hems/sensors/{zone}/{device_type}/{device_id}/{channel}
# and respond on mcp/+/response/#.
user hems-iot
topic write  hems/sensors/#
topic write  mcp/+/response/#
topic read   mcp/#
